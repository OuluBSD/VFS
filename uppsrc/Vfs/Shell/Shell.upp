description "VFS Shell - Command-line interface for VFS operations\377B128,0,0";

uses
	Vfs/Core;

mainconfig
	"" = "",
	"NCURSES" = "flagNCURSES";

library(LINUX & flagNCURSES) "ncursesw panelw formw menuw";
library(OSX & flagNCURSES) "ncurses";
library(BSD & !OSX & flagNCURSES) "ncursesw panelw formw menuw";

file
	Shell.h,
	VfsShell.h,
	VfsShell.cpp,
	VfsShellMain.cpp,
	ShellSyntax.h,
	ShellSyntax.cpp,
	Utils.h,
	NcursesEditor.h,
	NcursesEditor.cpp;
